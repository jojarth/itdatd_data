---
type HeaderField = 'eyebrow' | 'subeyebrow' | 'title' | 'subtitle';

interface Props {
  color?: string;
  type?: string;
  title?: string;
  eyebrow?: string;
  subeyebrow?: string;
  subtitle?: string;
  headerOrder?: HeaderField[];
}

const {
  color,
  type,
  title,
  eyebrow,
  subeyebrow,
  subtitle,
  headerOrder = ['eyebrow', 'title', 'subtitle'],
} = Astro.props as Props;

const normalizeColorName = (value: string) => {
  const lower = value.toLowerCase().trim();
  const aliases: Record<string, string> = {
    gray: 'grey',
    grey: 'grey',
    purple: 'purple',
    viloet: 'violet',
  };

  return aliases[lower] ?? lower.replace(/\s+/g, '-');
};

const legacyTypeMap: Record<string, string> = {
  class: 'green',
  feature: 'purple',
  subclass: 'blue',
  ancestry: 'indigo',
  archetype: 'yellow',
};

const resolvedColor = normalizeColorName(
  legacyTypeMap[(type ?? '').toLowerCase()] ?? color ?? 'purple',
);
const cardClass = `gameplay-card gameplay-card--${resolvedColor}`;
const headerFields: Record<HeaderField, string | undefined> = { eyebrow, subeyebrow, title, subtitle };
const orderedHeaderFields = (headerOrder as HeaderField[]).filter(
  (field): field is HeaderField => field in headerFields && Boolean(headerFields[field]),
);
const hasHeader = orderedHeaderFields.length > 0;
---

<aside class={cardClass}>
  {hasHeader && (
    <header class="gameplay-card__header">
      {
        orderedHeaderFields.map((field: HeaderField) => (
          <>
            {field === 'eyebrow' && <div class="gameplay-card__eyebrow">{headerFields[field]}</div>}
            {field === 'subeyebrow' && (
              <div class="gameplay-card__subeyebrow">{headerFields[field]}</div>
            )}
            {field === 'title' && <h3>{headerFields[field]}</h3>}
            {field === 'subtitle' && (
              <p class="gameplay-card__subtitle">{headerFields[field]}</p>
            )}
          </>
        ))
      }
    </header>
  )}
  <div class="gameplay-card__body">
    <slot />
  </div>
</aside>
