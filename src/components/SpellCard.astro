---
// Props: entry (ContentEntry), to (string | optional), excerpt (string | optional), displayFields (string[] | optional)
const { entry, to, excerpt, displayFields = ['level', 'casting', 'school', 'classes', 'excerpt'] } = Astro.props;
const href = to ?? `/data/${entry.id}`;
const showField = (field: string) => displayFields.includes(field);
const descriptionText = entry.data.shortDescription ?? excerpt;
const shouldShowDescription = showField('excerpt') || showField('shortDescription');
const classList = Array.isArray(entry.data.classes)
  ? [...entry.data.classes].sort((a, b) => a.localeCompare(b)).join(', ')
  : undefined;
---
<article class="spell-card">
  <div class="spell-card-inner">
    <div class="spell-card-header">
      <h3 class="spell-title"><a href={href}>{entry.data.title}</a></h3>
      <div class="spell-meta">
        {showField('level') && entry.data.level !== undefined && <span class="meta-item">Level {entry.data.level}</span>}
        {showField('casting') && entry.data.casting && <span class="meta-item">Casting: {entry.data.casting}</span>}
        {showField('school') && entry.data.school && <span class="meta-item">{entry.data.school}</span>}
        {showField('classes') && classList && (
          <span class="meta-item">{classList}</span>
        )}
      </div>
    </div>
    {shouldShowDescription && descriptionText ? (
      <p class="spell-excerpt">{descriptionText}</p>
    ) : null}
  </div>
</article>

<style>
.spell-card{border:1px solid var(--sl-border,#e5e7eb);padding:0.75rem;border-radius:8px;margin:0.5rem 0;background:var(--sl-bg,#fff)}
.spell-card-inner{display:flex;flex-direction:column}
.spell-card-header{display:flex;flex-direction:column}
.spell-title{margin:0 0 0.25rem 0;font-size:1.05rem}
.spell-title a{color:inherit;text-decoration:none}
.spell-meta{color:#6b7280;font-size:0.85rem}
.meta-item{margin-right:0.5rem}
.spell-excerpt{margin-top:0.5rem;color:#374151}
</style>
