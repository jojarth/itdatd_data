---
// Props: entry (ContentEntry), to/title/description/relation (optional), excerpt (optional), displayFields (optional)
const {
  entry,
  to,
  title,
  description,
  relation,
  excerpt,
  displayFields = ['level', 'casting', 'school', 'classes', 'excerpt'],
} = Astro.props;
const href = to ?? `/data/${entry.id}`;
const displayTitle = title ?? entry.data.title;
const showField = (field: string) => displayFields.includes(field);
const descriptionText = description ?? entry.data.shortDescription ?? excerpt;
const shouldShowDescription = showField('excerpt') || showField('shortDescription');
const classList = Array.isArray(entry.data.classes)
  ? [...entry.data.classes].sort((a, b) => a.localeCompare(b)).join(', ')
  : undefined;
const hasVisibleMetadata =
  (showField('level') && entry.data.level !== undefined) ||
  (showField('casting') && Boolean(entry.data.casting)) ||
  (showField('school') && Boolean(entry.data.school)) ||
  (showField('classes') && Boolean(classList));
---
<article class="spell-card">
  <div class="spell-card-inner">
    <div class="spell-card-header">
      <h3 class="spell-title"><a href={href}>{displayTitle}</a></h3>
      {relation ? <p class="spell-relation">{relation}</p> : null}
      {hasVisibleMetadata ? (
        <div class="spell-meta">
          {showField('level') && entry.data.level !== undefined && <span class="meta-item">Level {entry.data.level}</span>}
          {showField('casting') && entry.data.casting && <span class="meta-item">Casting: {entry.data.casting}</span>}
          {showField('school') && entry.data.school && <span class="meta-item">{entry.data.school}</span>}
          {showField('classes') && classList && (
            <span class="meta-item">{classList}</span>
          )}
        </div>
      ) : null}
    </div>
    {shouldShowDescription && descriptionText ? (
      <p class="spell-excerpt">{descriptionText}</p>
    ) : null}
  </div>
</article>

<style>
.spell-card{border:1px solid var(--sl-color-gray-5);padding:0.6rem 0.75rem;border-radius:8px;margin:0.2rem 0;background:var(--sl-color-bg);color:var(--sl-color-text)}
.spell-card-inner{display:flex;flex-direction:column}
.spell-card-header{display:flex;flex-direction:column}
.spell-title{margin:0;font-size:1.05rem;line-height:1.25}
.spell-title a{color:inherit;text-decoration:none}
.spell-relation{margin:0.1rem 0 0;color:var(--sl-color-gray-2);font-size:0.82rem;font-style:italic;line-height:1.3}
.spell-meta{margin-top:0.2rem;color:var(--sl-color-gray-2);font-size:0.85rem;line-height:1.3}
.meta-item{margin-right:0.5rem}
.spell-excerpt{margin:0.3rem 0 0;color:var(--sl-color-text);line-height:1.4}
</style>
