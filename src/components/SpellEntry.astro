---
import { spellAnchor } from "../lib/spellAnchor";
import SpellHeader from "./SpellHeader.astro";
import SpellMetadata from "./SpellMetadata.astro";

interface Props {
  title: string;
  summary?: string;
  variant?: "primary" | "reverse";
  label?: string;
  id?: string;
  metadata?: {
    level?: string | number;
    casting?: string;
    range?: string;
    duration?: string;
  };
}

const {
  title,
  summary,
  variant = "primary",
  label = variant === "reverse" ? "Reverse Spell" : "Spell",
  id,
  metadata,
} = Astro.props as Props;
const entryId = id ?? spellAnchor(title);
const isReverse = variant === "reverse";
---

<section id={entryId} class={`spell-entry spell-entry--${variant}`}>
  {isReverse ? (
    <SpellHeader
      title={title}
      level={metadata?.level}
      summary={summary}
      variant={variant}
      label={label}
    />
  ) : null}
  {metadata ? <SpellMetadata metadata={metadata} /> : null}
  <div class="spell-entry__body">
    <slot />
  </div>
</section>

<style>
  .spell-entry {
    --spell-entry-accent: var(--itdatd-spell-primary-section);
    --spell-subsection-accent: var(--itdatd-spell-primary-subsection);
    --feature-section-accent: var(--spell-entry-accent);
    --feature-subsection-accent: var(--spell-subsection-accent);
    display: grid;
    gap: 1.15rem;
    scroll-margin-top: 5rem;
  }

  .spell-entry--reverse {
    --spell-entry-accent: var(--itdatd-spell-reverse-section);
    --spell-subsection-accent: var(--itdatd-spell-reverse-subsection);
    margin-top: 2.5rem;
  }

  .spell-entry__body {
    display: grid;
    gap: 1rem;
  }

  /* Every major spell section receives the same top divider, including Spell Effect. */
  .spell-entry__body > :global(.feature-section) {
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }

</style>
