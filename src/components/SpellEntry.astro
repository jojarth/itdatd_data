---
import { spellAnchor } from "../lib/spellAnchor";

interface Props {
  title: string;
  summary?: string;
  variant?: "primary" | "reverse";
  label?: string;
  id?: string;
  metadata?: {
    level?: string | number;
    casting?: string;
    range?: string;
    duration?: string;
    classes?: string;
  };
}

const {
  title,
  summary,
  variant = "primary",
  label = variant === "reverse" ? "Reverse Spell" : "Spell",
  id,
  metadata,
} = Astro.props as Props;
const entryId = id ?? spellAnchor(title);
const isReverse = variant === "reverse";
const metadataFields = metadata
  ? [
      { label: "Spell Level", value: metadata.level },
      { label: "Casting", value: metadata.casting },
      { label: "Range", value: metadata.range },
      { label: "Duration", value: metadata.duration },
      { label: "Classes", value: metadata.classes },
    ].filter((field) => field.value !== undefined && field.value !== "")
  : [];
---

<section id={entryId} class={`spell-entry spell-entry--${variant}`}>
  {isReverse ? (
    <>
      <div class="spell-entry__divider" aria-hidden="true"></div>
      <header class="spell-entry__header">
        <span class="spell-entry__label">{label}</span>
        <h2>{title}</h2>
        {summary ? <p class="spell-entry__summary">{summary}</p> : null}
      </header>
    </>
  ) : null}
  {metadataFields.length > 0 ? (
    <div class="spell-entry__metadata">
      {metadataFields.map((field) => (
        <p class="spell-entry__metadata-item">
          <strong>{field.label}</strong>
          <span>{field.value}</span>
        </p>
      ))}
    </div>
  ) : null}
  <div class="spell-entry__body">
    <slot />
  </div>
</section>

<style>
  .spell-entry {
    --spell-entry-accent: #d6a725;
    display: grid;
    gap: 1.15rem;
    scroll-margin-top: 5rem;
  }

  .spell-entry--reverse {
    --spell-entry-accent: #8b5cf6;
    margin-top: 1.5rem;
  }

  .spell-entry__divider {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.45rem;
    align-items: center;
  }

  .spell-entry__divider::before,
  .spell-entry__divider::after {
    display: block;
    height: 2px;
    content: "";
  }

  .spell-entry__divider::before {
    background: var(--spell-entry-accent);
  }

  .spell-entry__divider::after {
    background: var(--sl-color-gray-5);
  }

  .spell-entry__header {
    display: grid;
    gap: 0.2rem;
  }

  .spell-entry__label {
    color: var(--sl-color-gray-2);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .spell-entry__header h2 {
    margin: 0;
  }

  .spell-entry__summary {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-style: italic;
  }

  .spell-entry__metadata {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .spell-entry__metadata-item {
    display: grid;
    gap: 0.2rem;
    margin: 0;
  }

  .spell-entry__metadata-item strong {
    color: var(--sl-color-gray-2);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .spell-entry__body {
    display: grid;
    gap: 1rem;
  }

  .spell-entry__body :global(.feature-section) {
    position: relative;
    padding: 1rem 0 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .spell-entry__body :global(.feature-section)::before,
  .spell-entry__body :global(.feature-section)::after {
    position: absolute;
    top: 0;
    display: block;
    height: 2px;
    content: "";
  }

  .spell-entry__body :global(.feature-section)::before {
    left: 0;
    width: 7rem;
    background: var(--spell-entry-accent);
  }

  .spell-entry__body :global(.feature-section)::after {
    right: 0;
    left: 7.45rem;
    background: var(--sl-color-gray-5);
  }

  .spell-entry__body :global(.feature-section h5) {
    margin: 0 0 0.65rem;
    font-size: 1.05rem;
  }

  .spell-entry__body :global(.feature-section h6) {
    margin: 1rem 0 0.55rem;
    padding: 0.45rem 0.65rem;
    border-left: 3px solid var(--spell-entry-accent);
    border-radius: 0 4px 4px 0;
    background: color-mix(in srgb, var(--spell-entry-accent) 9%, transparent);
    color: var(--sl-color-text);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 38rem) {
    .spell-entry__divider {
      grid-template-columns: 4rem 1fr;
    }

    .spell-entry__metadata {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .spell-entry__body :global(.feature-section)::before {
      width: 4rem;
    }

    .spell-entry__body :global(.feature-section)::after {
      left: 4.45rem;
    }
  }
</style>
