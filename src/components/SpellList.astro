---
import SpellCard from "./SpellCard.astro";
import { spellAnchor } from "../lib/spellAnchor";

const props = Astro.props as {
  entries?: any[];
  datatype?: string;
  level?: number;
  className?: string;
  tag?: string;
  sortBy?: string;
  sortDir?: "asc" | "desc";
  title?: string;
  showHeading?: boolean;
  showReverse?: boolean;
  hidePrimary?: boolean;
  displayFields?: Array<"level" | "casting" | "school" | "classes" | "excerpt" | "shortDescription">;
};

const {
  entries = [],
  datatype = "spell",
  level,
  className,
  tag,
  sortBy = "title",
  sortDir = "asc",
  title = "Spell List",
  showHeading = true,
  showReverse = false,
  hidePrimary = false,
  displayFields = ["level", "casting", "school", "classes", "excerpt"],
} = props;

const filtered = (entries ?? []).filter((entry) => {
    if (!entry?.data) return false;
    if (datatype && entry.data.datatype !== datatype) return false;
    if (level !== undefined && entry.data.level !== level) return false;
    if (className && !Array.isArray(entry.data.classes)) return false;
    if (className && !entry.data.classes.includes(className)) return false;
    if (tag && (!Array.isArray(entry.data.tags) || !entry.data.tags.includes(tag))) return false;
    return true;
  });

const cards = filtered
  .flatMap((entry) => {
    const baseUrl = `/data/${entry.id}`;
    const hasReverse = Boolean(entry.data.reverseTitle);
    const includeReverse = (showReverse || hidePrimary) && hasReverse;
    const primary = {
      entry,
      title: entry.data.title,
      description: entry.data.shortDescription,
      relation: includeReverse ? `Reverse: ${entry.data.reverseTitle}` : undefined,
      to: includeReverse ? `${baseUrl}#_top` : baseUrl,
    };

    const forms = hidePrimary ? [] : [primary];

    if (includeReverse) {
      forms.push({
        entry,
        title: entry.data.reverseTitle,
        description: entry.data.reverseShortDescription,
        relation: `Reverse of: ${entry.data.title}`,
        to: `${baseUrl}#${spellAnchor(entry.data.reverseTitle)}`,
      });
    }

    return forms;
  })
  .sort((a, b) => {
    if (sortBy === "level") {
      return sortDir === "desc"
        ? (b.entry.data.level ?? 0) - (a.entry.data.level ?? 0)
        : (a.entry.data.level ?? 0) - (b.entry.data.level ?? 0);
    }

    const left = String(a.title).toLowerCase();
    const right = String(b.title).toLowerCase();
    if (left === right) return 0;
    if (sortDir === "desc") return right < left ? -1 : 1;
    return left < right ? -1 : 1;
  });
---
<section class="spell-list">
  {showHeading ? <h2>{title}</h2> : null}
  {cards.length === 0 ? (
    <p>No spells matched the current filters.</p>
  ) : (
    <div class="spell-list-stack">
      {cards.map((card) => (
        <SpellCard
          entry={card.entry}
          title={card.title}
          description={card.description}
          relation={card.relation}
          to={card.to}
          excerpt={card.entry.data?.excerpt}
          displayFields={displayFields}
        />
      ))}
    </div>
  )}
</section>

<style>
.spell-list { margin: 1rem 0; }
.spell-list-stack { display: flex; flex-direction: column; gap: 0.15rem; }
</style>
