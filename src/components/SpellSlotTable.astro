---
import spellSlots from '../content/data/spelldata/spell_slots/spell_slots.json';

interface Props {
  rank?: 'A' | 'B' | 'C' | 'D' | 'E';
  colorTheme?:
    | 'blue-table'
    | 'green-table'
    | 'red-table'
    | 'orange-table'
    | 'grey-table'
    | 'pink-table'
    | 'purple-table'
    | 'yellow-table';
  title?: string;
  caption?: string;
  boldColumn?: number | string | Array<number | string>;
  boldColumns?: number | string | Array<number | string>;
  boldRow?: number | string | Array<number | string>;
  boldRows?: number | string | Array<number | string>;
  boldcolumn?: number | string | Array<number | string>;
  boldrow?: number | string | Array<number | string>;
  boldHeader?: boolean;
  boldheader?: boolean;
}

const {
  rank = 'A',
  colorTheme = 'blue-table',
  title,
  caption,
  boldColumn,
  boldColumns,
  boldRow,
  boldRows,
  boldcolumn,
  boldrow,
  boldHeader = false,
  boldheader = false,
} = Astro.props as Props;
const rankKey = String(rank).trim().toUpperCase() as 'A' | 'B' | 'C' | 'D' | 'E';

type SpellSlotRow = { 'Class Level': string | number | null } & Record<string, string | number | null>;

type RawSpellSlotColumn = Array<string | number | null | undefined>;
type RawSpellSlotRank = Record<string, RawSpellSlotColumn>;

const rawRankData = (spellSlots[rankKey] ?? []) as Array<RawSpellSlotRank>;

if (!rawRankData.length) {
  throw new Error(`SpellSlotTable: no data found for rank ${rankKey}.`);
}

const rawRankRow = rawRankData[0];
const columnKeys = Object.keys(rawRankRow)
  .filter((key) => key !== 'Class Level')
  .sort((left, right) => {
    const leftMatch = left.match(/(\d+)/);
    const rightMatch = right.match(/(\d+)/);
    const leftNum = leftMatch ? Number(leftMatch[1]) : 0;
    const rightNum = rightMatch ? Number(rightMatch[1]) : 0;
    return leftNum - rightNum;
  });

const rowCount = Math.max(
  ...Object.values(rawRankRow).map((column) => (Array.isArray(column) ? column.length : 0))
);

const rows = Array.from({ length: rowCount }, (_, index) => {
  const row: Record<string, string | number | null | undefined> = {};

  for (const key of ['Class Level', ...columnKeys]) {
    const column = rawRankRow[key];
    row[key] = Array.isArray(column) ? column[index] : undefined;
  }

  return row as SpellSlotRow;
});

if (!rows.length) {
  throw new Error(`SpellSlotTable: no data found for rank ${rankKey}.`);
}

const columns: Array<{ key: string; label: string; align: 'left' | 'center' | 'right' }> = [
  { key: 'Class Level', label: 'Class Level', align: 'center' },
  ...columnKeys.map((key) => ({ key, label: key, align: 'center' as const })),
];

const numberFormatter = new Intl.NumberFormat('en-US', {
  maximumFractionDigits: 20,
});

function formatCellValue(value: any): string {
  if (value === null || value === undefined || value === '') {
    return '-';
  }

  if (typeof value === 'number') {
    return numberFormatter.format(value);
  }

  return String(value).trim() || '-';
}

function normalizeIndexes(value: Props['boldColumn']): Set<number> {
  const values = Array.isArray(value) ? value : [value];
  return new Set(
    values
      .flatMap((item) => String(item ?? '').split(','))
      .map((item) => Number(item.trim()))
      .filter((item) => Number.isInteger(item) && item > 0)
  );
}

const boldColumnIndexes = normalizeIndexes(boldColumn ?? boldColumns ?? boldcolumn);
const boldRowIndexes = normalizeIndexes(boldRow ?? boldRows ?? boldrow);
const shouldBoldHeader = boldHeader || boldheader;

function isBoldCell(rowIndex: number | undefined, columnIndex: number): boolean {
  const columnNumber = columnIndex + 1;
  const rowNumber = rowIndex === undefined ? undefined : rowIndex + 1;

  return (
    boldColumnIndexes.has(columnNumber) ||
    (rowNumber !== undefined && boldRowIndexes.has(rowNumber))
  );
}
---

<div class="spell-slot-table">
  {title && <p class="spell-slot-table-title"><strong>{title}</strong></p>}

  <div class={colorTheme}>
    <table>
      <thead>
        <tr>
          {columns.map((column, columnIndex) => (
            <th
              class={shouldBoldHeader || isBoldCell(undefined, columnIndex) ? 'is-bold' : undefined}
              style={`text-align: ${column.align}`}
            >
              {column.label}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row, rowIndex) => (
          <tr>
            {columns.map((column, columnIndex) => (
              <td
                class={isBoldCell(rowIndex, columnIndex) ? 'is-bold' : undefined}
                style={`text-align: ${column.align}`}
              >
                {formatCellValue(row[column.key])}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {caption && <p class="spell-slot-table-caption">{caption}</p>}
</div>

<style>
  .spell-slot-table {
    margin: 2rem 0;
  }

  .spell-slot-table-title,
  .spell-slot-table-caption {
    margin: 0.75rem 0 0.5rem;
    font-size: 0.95rem;
    color: inherit;
  }

  .spell-slot-table .is-bold {
    font-weight: 700;
  }
</style>
