---
// src/components/WeaponLookup.astro
import properties from '../content/data/weapondata/properties.json';
import features from '../content/data/weapondata/features.json';

interface Props {
  id: string;
  type: 'property' | 'feature';
}

const { id, type } = Astro.props;
const hasValidId = id && id.trim() !== "" && id !== "—";

const dataSource = type === 'property' ? properties : features;
const targetPage = ''; // Links to the same page anchors

const match = hasValidId ? dataSource.find(item => item.id === id) : null;
const displayName = match ? match.name : id;
const description = match ? match.description : 'Description not found.';
---

{hasValidId ? (
  /* We attach the description directly to the link data attributes */
  <a
    href={`${targetPage}#${id}`}
    class="weapon-tooltip-trigger"
    data-tip={description}
  >
    {displayName}
  </a>
) : (
  <span class="empty-cell">—</span>
)}

<style>
  .weapon-tooltip-trigger {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-decoration-style: dashed;
    cursor: help;
    display: inline-block;
  }
  .empty-cell {
    color: var(--sl-color-gray-4);
  }
</style>
