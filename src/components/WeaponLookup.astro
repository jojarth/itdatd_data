---
// src/components/WeaponLookup.astro
import { getEntry } from "astro:content";

interface Props {
  id: string;
  type: 'property' | 'feature';
}

const { id, type } = Astro.props;
const hasValidId = id && id.trim() !== "" && id !== "—";

const match = hasValidId
  ? type === "property"
    ? await getEntry("weaponProperties", id)
    : await getEntry("weaponFeatures", id)
  : undefined;
const targetPage = type === "property" ? "/data/weapon-properties" : "/data/weapon-features";
const displayName = match?.data.title ?? id;
const tooltipText = match?.data.shortDescription ?? "Description not found.";
---

{hasValidId ? (
  /* We attach the description directly to the link data attributes */
  <a
    href={`${targetPage}/${id}`}
    class="weapon-tooltip-trigger"
    data-tip={tooltipText}
    title={tooltipText}
  >
    {displayName}
  </a>
) : (
  <span class="empty-cell">—</span>
)}

<style>
  .weapon-tooltip-trigger {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-decoration-style: dashed;
    cursor: pointer;
    display: inline-block;
  }
  .empty-cell {
    color: var(--sl-color-gray-4);
  }
</style>
