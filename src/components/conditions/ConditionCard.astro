---
// Shows one condition.
// Usage: <ConditionCard id="battle-trance" />  <ConditionCard id="slow" />
// Add toc to list it in the page's table of contents: <ConditionCard id="dazed" toc />
// Pass anchor={false} if the same entry is shown twice on one page.
import { getEntry, render } from "astro:content";
import GameplayCard from "../GameplayCard.astro";
import { stackingLabels } from "./conditionPaths";

interface Props {
  id?: string;
  entry?: any;
  anchor?: boolean | string;
}

const { id, entry: passedEntry, anchor = true } = Astro.props as Props;
const showAnchor = anchor !== false && anchor !== "false";
const entry = passedEntry ?? (id ? await getEntry("conditions", id) : undefined);

if (!entry) {
  throw new Error(`ConditionCard: no condition found with id "${id}". Check src/content/data/conditiondata.`);
}

const { Content } = await render(entry);
const data = entry.data;
const nameBits = [data.parameter, data.valued ? "X" : undefined].filter(Boolean);
const title = nameBits.length ? `${data.title} (${nameBits.join(", ")})` : data.title;
const stacking = data.stacking ? stackingLabels[data.stacking] : undefined;

---

<div class="condition-card" id={showAnchor ? entry.id : undefined}>
  <GameplayCard colorSet="System" eyebrow="Condition" title={title} headerOrder={["eyebrow", "title"]}>
    <Content />
    {data.impairsRest && (
      <p class="condition-card__note"><strong>Impairs Rest:</strong> This condition imposes a rest penalty if it lasts at least half of a rest.</p>
    )}
    {stacking && (
      <p class="condition-card__note"><strong>Multiple Effects:</strong> {stacking}.</p>
    )}
  </GameplayCard>
</div>

<style>
  .condition-card {
    scroll-margin-top: 5rem;
  }
  /* Linked effect titles (e.g. Action Delay) look like plain bold titles. */
  .condition-card :global(a:has(> strong)) {
    color: inherit;
    text-decoration-style: dashed;
    text-decoration-thickness: 1px;
  }
  .condition-card__note {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
</style>
