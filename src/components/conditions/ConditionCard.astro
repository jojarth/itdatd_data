---
// Shows one condition from src/content/data/conditiondata.
// Usage: <ConditionCard id="battle-trance" />
// Add toc to list it in the page's table of contents: <ConditionCard id="slow" toc />
// Pass anchor={false} if the same condition is shown twice on one page.
import { getEntry, render } from "astro:content";
import GameplayCard from "../GameplayCard.astro";
import { stackingLabels } from "./conditionPaths";

interface Props {
  id?: string;
  entry?: any;
  anchor?: boolean | string;
}

const { id, entry: passedEntry, anchor = true } = Astro.props as Props;
const showAnchor = anchor !== false && anchor !== "false";
const entry = passedEntry ?? (id ? await getEntry("conditions", id) : undefined);

if (!entry) {
  throw new Error(`ConditionCard: no condition found with id "${id}". Check src/content/data/conditiondata.`);
}

const { Content } = await render(entry);
const title = entry.data.valued ? `${entry.data.title} (X)` : entry.data.title;
const stacking = stackingLabels[entry.data.stacking];
---

<div class="condition-card" id={showAnchor ? entry.id : undefined}>
  <GameplayCard colorSet="System" eyebrow="Condition" title={title} headerOrder={["eyebrow", "title"]}>
    <Content />
    {stacking && (
      <p class="condition-card__stacking"><strong>Multiple Effects:</strong> {stacking}.</p>
    )}
  </GameplayCard>
</div>

<style>
  .condition-card {
    scroll-margin-top: 5rem;
  }
  .condition-card__stacking {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
</style>
