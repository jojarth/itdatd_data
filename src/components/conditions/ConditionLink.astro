---
// Inline link to a condition, with its short description as a tooltip.
// Usage: <ConditionLink id="dazed" />
//        <ConditionLink id="frightened" text="Frightened (2)" />
import { getEntry } from "astro:content";
import { CONDITIONS_PAGE } from "./conditionPaths";

interface Props {
  id: string;
  text?: string;
}

const { id, text } = Astro.props as Props;
const entry = await getEntry("conditions", id);

if (!entry) {
  throw new Error(`ConditionLink: no condition found with id "${id}". Check src/content/data/conditiondata.`);
}

const label = text ?? entry.data.title;
---

<a href={`${CONDITIONS_PAGE}#${entry.id}`} class="condition-link" title={entry.data.shortDescription}>{label}</a>

<style>
  .condition-link {
    text-decoration-style: dashed;
  }
</style>
