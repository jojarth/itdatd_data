---
// Shows every condition (or hindrance), alphabetically, or only those with a given tag.
// Usage: <ConditionList />  <ConditionList kind="hindrance" />  <ConditionList tag="combat" />
// Add toc to list each entry in the page's table of contents: <ConditionList toc />
// (The id prop shows a single entry; the table-of-contents plugin uses it.)
import { getCollection } from "astro:content";
import ConditionCard from "./ConditionCard.astro";
import { kindFor } from "./conditionPaths";

interface Props {
  kind?: "condition" | "hindrance";
  tag?: string;
  id?: string;
  anchor?: boolean | string;
}

const { kind, tag, id, anchor = true } = Astro.props as Props;
const config = kindFor(kind);
const all = await getCollection(config.collection);
const entries = all
  .filter((e) => !id || e.id === id)
  .filter((e) => !tag || (e.data.tags ?? []).includes(tag))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

if (entries.length === 0) {
  throw new Error(`ConditionList: no ${kind ?? "condition"} entries found${id ? ` with id "${id}"` : ""}${tag ? ` with tag "${tag}"` : ""}.`);
}
---

{entries.map((entry) => <ConditionCard kind={kind} entry={entry} anchor={anchor} />)}
