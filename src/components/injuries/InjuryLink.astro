---
// Inline link to a lasting injury, with its short description as a tooltip.
// Usage: <InjuryLink id="broken-arm" />  or  <InjuryLink id="broken-arm" text="broken arm" />
import { getEntry } from "astro:content";
import { INJURY_PAGE } from "./injuryPaths";

interface Props {
  id: string;
  text?: string;
}

const { id, text } = Astro.props as Props;
const entry = await getEntry("injuries", id);

if (!entry) {
  throw new Error(`InjuryLink: no lasting injury found with id "${id}". Check src/content/data/injurydata/injuries.`);
}

const label = text ?? entry.data.title;
---

<a href={`${INJURY_PAGE}#${entry.id}`} class="injury-link" title={entry.data.shortDescription}>{label}</a>

<style>
  .injury-link {
    text-decoration-style: dashed;
  }
</style>
