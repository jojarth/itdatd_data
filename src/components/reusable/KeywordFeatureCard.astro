---
import GameplayCard from '../GameplayCard.astro';

interface Props {
  color?: string;
  colorSet?: string;
  sectionColor?: string;
  subsectionColor?: string;
  level?: number;
  toc?: boolean;
  tocDepth?: number;
}

const {
  color,
  colorSet = 'characterfeature',
  sectionColor,
  subsectionColor,
  level = 4,
  toc = false,
  tocDepth,
} = Astro.props as Props;

function ordinal(value: number): string {
  const remainder = value % 100;
  if (remainder >= 11 && remainder <= 13) return `${value}th`;
  switch (value % 10) {
    case 1: return `${value}st`;
    case 2: return `${value}nd`;
    case 3: return `${value}rd`;
    default: return `${value}th`;
  }
}

const levelLabel = ordinal(level);
---

<GameplayCard
  color={color}
  colorSet={colorSet}
  sectionColor={sectionColor}
  subsectionColor={subsectionColor}
  title="Keyword Feature"
  subeyebrow={`${levelLabel} Level Character Feature`}
  headerOrder={['title', 'subeyebrow']}
  toc={toc}
  tocDepth={tocDepth}
>
  <p>
    Upon reaching {levelLabel} level, you gain a Keyword Feature. See <a href="/playersguide/11-character_advancement/keywordfeatures/"><em>Keyword Features</em> in Chapter 11: Advancement</a> for how to select one.
  </p>
</GameplayCard>
