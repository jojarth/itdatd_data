---
type Tradition = 'Military' | 'Devotional' | 'Stewardship';

interface Props {
  tradition: Tradition;
  title: string;
  featureTitle: string;
}

const { tradition, title, featureTitle } = Astro.props as Props;
const variant = tradition.toLowerCase();
---

<section class={`order-tradition order-tradition--${variant}`}>
  <header class="order-tradition__header">
    <span class="order-tradition__label">{tradition} Tradition</span>
    <h6>{title}</h6>
    <p class="order-tradition__feature">{featureTitle}</p>
  </header>
  <div class="order-tradition__body">
    <slot />
  </div>
</section>
