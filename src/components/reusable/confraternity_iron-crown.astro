---
import FeatureSection from '../FeatureSection.astro';
import OrderTradition from './OrderTradition.astro';

type Tradition = 'Military' | 'Devotional' | 'Stewardship';

interface Props {
  include?: Array<Tradition | string>;
}

const { include = ['Military', 'Devotional', 'Stewardship'] } = Astro.props as Props;

const traditionAliases: Record<string, Tradition> = {
  martial: 'Military',
  military: 'Military',
  devotional: 'Devotional',
  devotion: 'Devotional',
  stewardship: 'Stewardship',
};

const includedTraditions = include
  .map((tradition) => traditionAliases[String(tradition).trim().toLowerCase()])
  .filter((tradition): tradition is Tradition => Boolean(tradition));

const shouldShow = (tradition: Tradition) => includedTraditions.includes(tradition);
---

<FeatureSection title="Confraternity of the Iron Crown">
    <p style="margin-top: 0;"><small><i>Order is the foundation of peace</i></small></p>

      <p>Members of the Confraternity of the Iron Crown uphold the virtues of authority, command, and discipline. They believe strength and conviction are necessary to guide society, and that those entrusted with power have a responsibility to protect the common folk. Their methods often bring them into conflict with rulers and nobles, though they maintain that their cause is just.</p>

        <p>Regardless of whether you belong to its Military, Devotional, or Stewardship tradition, you gain the <b>Confraternity of the Iron Crown</b> Adventure Keyword.</p>

  {shouldShow('Military') && (
    <OrderTradition tradition="Military" title="The Commanders" featureTitle="Commanding Presence">
      <p>If your allies can see and hear you, they can utilize the Help Activity 1 Phase earlier than normal. Additionally, such allies increase the bonuses provided by taking the Focus on Defense action by +1.</p>
    </OrderTradition>
  )}

  {shouldShow('Devotional') && (
    <OrderTradition tradition="Devotional" title="The Voices of Authority" featureTitle="Unyielding Authority">
      <p>When an adjacent ally fails a Saving Throw against fear, charm, or an effect that would compel them to act against their beliefs, you may use your Reaction to allow them to reroll the Saving Throw.</p>
    </OrderTradition>
  )}

  {shouldShow('Stewardship') && (
    <OrderTradition tradition="Stewardship" title="The Seneschals" featureTitle="Voice of the Iron Crown">
      <p>You gain a bonus to your maximum henchmen and your hencmen's loyalty base equal to 1/2 your class level.</p>
    </OrderTradition>
  )}
</FeatureSection>
