---
import FeatureSection from '../FeatureSection.astro';
import OrderTradition from './OrderTradition.astro';

type Tradition = 'Military' | 'Devotional' | 'Stewardship';

interface Props {
  include?: Array<Tradition | string>;
}

const { include = ['Military', 'Devotional', 'Stewardship'] } = Astro.props as Props;

const traditionAliases: Record<string, Tradition> = {
  martial: 'Military',
  military: 'Military',
  devotional: 'Devotional',
  devotion: 'Devotional',
  stewardship: 'Stewardship',
};

const includedTraditions = include
  .map((tradition) => traditionAliases[String(tradition).trim().toLowerCase()])
  .filter((tradition): tradition is Tradition => Boolean(tradition));

const shouldShow = (tradition: Tradition) => includedTraditions.includes(tradition);
---

<FeatureSection title="Knights of the Black Lion">
    <p style="margin-top: 0;"><small><i>Honor and protection</i></small></p>
    <p>The Knights of the Black Lion uphold the virtues of loyalty, honor, and martial excellence. They do not seek to destroy every threat they encounter, but instead dedicate themselves to maintaining order and defending those placed under their protection.</p>

      <p>Regardless of whether you belong to its Military, Devotional, or Stewardship tradition, you gain the <b>Knights of the Black Lion</b> Adventure Keyword.</p>

  {shouldShow('Military') && (
    <OrderTradition tradition="Military" title="The Shield Bearers" featureTitle="Consummate Protector">
      <p>For 1 Action starting in Phase 1, you can designate an adjacent ally as the target of your protection. So long as they are adjacent to you, they gain a +1 situation bonus to AC. This benefit lasts until you protect another ally.</p>
    </OrderTradition>
  )}

  {shouldShow('Devotional') && (
    <OrderTradition tradition="Devotional" title="The Lionhearts" featureTitle="Steadfast Conviction">
      <p>Any time you use the Help action in combat, or cast a beneficial spell that targets an ally, the ally who was the beneficiary of your action or spell gain a +1 situation bonus to their AC and Saving Throws until this phase next round.</p>
    </OrderTradition>
  )}

  {shouldShow('Stewardship') && (
    <OrderTradition tradition="Stewardship" title="The Wardens" featureTitle="Guardian's Eye">
      <p>You are unable to be surprised. Additionally, while exploring, you reduce the chances of any surprise ambush for your entire party by -1-in-Y.</p>
    </OrderTradition>
  )}
</FeatureSection>
