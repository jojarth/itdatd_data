---
import { getCollection, getEntry, render } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import WeaponLookup from "../../components/WeaponLookup.astro";
import MdxContentWrapper from "../../components/MdxContentWrapper.astro";
import SpellHeader from "../../components/SpellHeader.astro";
import SpellMetadata from "../../components/SpellMetadata.astro";
import { spellAnchor } from "../../lib/spellAnchor";
import { formatEncumbrance, formatStatePair } from "../../lib/formatEncumbrance";

export async function getStaticPaths() {
  const [spells, weapons, weaponProperties, weaponFeatures, armors, shields, items] = await Promise.all([
    getCollection("data"),
    getCollection("weapons"),
    getCollection("weaponProperties"),
    getCollection("weaponFeatures"),
    getCollection("armors"),
    getCollection("shields"),
    getCollection("items"),
  ]);

  return [
    ...spells.map((entry) => ({
      params: { slug: entry.id },
      props: { collection: "data", id: entry.id },
    })),
    ...weapons.map((entry) => ({
      params: { slug: `weapons/${entry.id}` },
      props: { collection: "weapons", id: entry.id },
    })),
    ...weaponProperties.map((entry) => ({
      params: { slug: `weapon-properties/${entry.id}` },
      props: { collection: "weaponProperties", id: entry.id },
    })),
    ...weaponFeatures.map((entry) => ({
      params: { slug: `weapon-features/${entry.id}` },
      props: { collection: "weaponFeatures", id: entry.id },
    })),
    ...armors.map((entry) => ({
      params: { slug: `armors/${entry.id}` },
      props: { collection: "armors", id: entry.id },
    })),
    ...shields.map((entry) => ({
      params: { slug: `shields/${entry.id}` },
      props: { collection: "shields", id: entry.id },
    })),
    ...items.map((entry) => ({
      params: { slug: `items/${entry.id}` },
      props: { collection: "items", id: entry.id },
    })),
  ];
}

type DetailCollection = "data" | "weapons" | "weaponProperties" | "weaponFeatures" | "armors" | "shields" | "items";

const { collection, id } = Astro.props as {
  collection: DetailCollection;
  id: string;
};
const entry = await getEntry(collection, id);

if (!entry) {
  throw new Error(`No ${collection} entry found for ID: ${id}`);
}

const renderResult = await render(entry);
const { Content } = renderResult ?? {};
const isSpell = collection === "data";
const isWeapon = collection === "weapons";
const isArmor = collection === "armors";
const isShield = collection === "shields";
const isItem = collection === "items";
const spellClasses =
  isSpell && Array.isArray(entry.data.classes) && entry.data.classes.length > 0
    ? [...entry.data.classes].sort((a, b) => a.localeCompare(b))
    : [];
const primarySpellMetadata = isSpell
  ? {
      casting: entry.data.casting,
      range: entry.data.range,
      duration: entry.data.duration,
    }
  : undefined;

const detailFields = isWeapon
  ? [
        { key: "group", label: "Weapon Group", value: entry.data.group },
        { key: "cost", label: "Cost", value: entry.data.cost },
        { key: "ep", label: "EP", value: `${entry.data.ep}` },
        { key: "damage", label: "Damage", value: entry.data.damage },
        { key: "speed", label: "Speed", value: `${entry.data.speed}` },
        { key: "range", label: "Range", value: entry.data.range },
      ]
    : isArmor
      ? [
          { key: "ac", label: "AC", value: `${entry.data.ac}` },
          { key: "epEquipped", label: "EP Equipped", value: `${entry.data.epEquipped}` },
          { key: "epPacked", label: "EP Packed", value: `${entry.data.epPacked}` },
          { key: "cost", label: "Cost", value: entry.data.cost },
        ]
    : isShield
      ? [
          { key: "category", label: "Type", value: entry.data.category },
          { key: "material", label: "Material", value: entry.data.material },
          { key: "cost", label: "Cost", value: entry.data.cost },
          { key: "ep", label: "EP Equipped/Packed", value: formatStatePair(entry.data.encumbrance) },
          { key: "ac", label: "AC Bonus", value: `${entry.data.acBonus}` },
          { key: "block", label: "Block Value", value: `${entry.data.blockValue}` },
          { key: "breakDie", label: "Break Die", value: entry.data.breakDie },
          { key: "breakChance", label: "Break Chance", value: `${entry.data.breakChance}` },
          { key: "checkPenalty", label: "Check Penalty", value: entry.data.checkPenalty === 0 ? "—" : `${entry.data.checkPenalty} Situation` },
        ]
    : isItem
      ? [
          { key: "category", label: "Category", value: entry.data.category },
          { key: "cost", label: "Cost", value: entry.data.cost },
          { key: "ep", label: "EP", value: formatEncumbrance(entry.data.encumbrance) },
          { key: "notes", label: "Notes", value: entry.data.notes },
        ]
  : [];

const description = entry.data.shortDescription ?? entry.data.excerpt ?? undefined;
const displayTitle = entry.data.title;
const reverseMetadata =
  isSpell && entry.data.reverseTitle
    ? {
        level: entry.data.level,
        casting: entry.data.reverseCasting ?? entry.data.casting,
        range: entry.data.reverseRange ?? entry.data.range,
        duration: entry.data.reverseDuration ?? entry.data.duration,
      }
    : undefined;
const weaponProperties = isWeapon ? entry.data.properties : [];
const proficiencyFeatures = isWeapon
  ? [
      { label: "Proficient", entries: entry.data.proficient },
      { label: "Skilled", entries: entry.data.skilled },
      { label: "Expert", entries: entry.data.expert },
      { label: "Master", entries: entry.data.master },
      { label: "Grand Master", entries: entry.data.grandmaster },
    ]
  : [];
---

<StarlightPage
  frontmatter={{
    title: displayTitle,
    description,
  }}
>
  <article class={`data-detail ${isSpell ? "data-detail--spell" : ""}`}>
    {isSpell ? (
      <>
        <SpellHeader
          title={displayTitle}
          level={entry.data.level}
          summary={description}
          variant="primary"
          headingLevel={1}
        />
        {entry.data.reverseTitle ? (
          <p class="data-reverse-link">
            <strong>Reverse form:</strong>{" "}
            <a href={`#${spellAnchor(entry.data.reverseTitle)}`}>{entry.data.reverseTitle}</a>
          </p>
        ) : null}
      </>
    ) : description ? (
      <p class="data-lead"><em>{description}</em></p>
    ) : null}

    {isSpell ? (
      <SpellMetadata metadata={primarySpellMetadata} />
    ) : detailFields.length > 0 ? (
      <div class="data-metadata">
        {detailFields.map((field) =>
          field.value !== undefined && field.value !== "" ? (
            <p class="data-metadata-item">
              <strong class="data-metadata-label">{field.label}{isSpell ? "" : ":"}</strong>{" "}
              <span class="data-metadata-value">{field.value}</span>
            </p>
          ) : null
        )}
      </div>
    ) : null}

    {isWeapon ? (
      <div class="weapon-rules-links">
        <section>
          <h2>Weapon Properties</h2>
          {weaponProperties.length > 0 ? (
            <p>
              {weaponProperties.map((property, index) => (
                <>
                  {index > 0 ? ", " : null}
                  <WeaponLookup id={property.id} type="property" />
                </>
              ))}
            </p>
          ) : (
            <p>None.</p>
          )}
        </section>

        <section>
          <h2>Proficiency Features</h2>
          <dl class="proficiency-list">
            {proficiencyFeatures.map(({ label, entries }) => (
              <div class="proficiency-row">
                <dt>{label}</dt>
                <dd>
                  {entries.length > 0
                    ? entries.map((feature, index) => (
                        <>
                          {index > 0 ? ", " : null}
                          <WeaponLookup id={feature.id} type="feature" />
                        </>
                      ))
                    : "—"}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      </div>
    ) : null}

    {Content ? (
      <div class="data-body">
        <Content
          components={{ wrapper: MdxContentWrapper }}
          reverseMetadata={reverseMetadata}
        />
      </div>
    ) : (
      <div class="warning">
        <p>Unable to render Content for entry <strong>{entry.id}</strong>.</p>
        <pre>{JSON.stringify({ id: entry.id, filePath: entry.filePath, data: entry.data }, null, 2)}</pre>
      </div>
    )}

    {isSpell && spellClasses.length > 0 ? (
      <aside
        class={`data-spell-classes ${entry.data.reverseTitle ? "data-spell-classes--reversible" : ""}`}
        aria-label="Spellcasting classes"
      >
        <h2 class="data-spell-classes__title">Spellcasting Classes</h2>
        <p>This spell is on the spell list of the following classes:</p>
        <ul>
          {spellClasses.map((className) => <li><em>{className}</em></li>)}
        </ul>
      </aside>
    ) : null}
  </article>
</StarlightPage>

<style>
.data-detail {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.data-lead {
  margin: 0;
  font-size: 1.05rem;
  color: var(--sl-color-text-accent, #374151);
}

.data-reverse-link {
  margin: 0;
  color: var(--sl-color-gray-2);
  font-size: 0.9rem;
}

.data-metadata {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
  margin: 0;
}

.data-metadata-item {
  line-height: 1.35;
  margin: 0;
}

.data-metadata-label {
  font-weight: 600;
  color: var(--sl-color-text, #111827);
}

.data-metadata-value {
  color: var(--sl-color-text, #111827);
}

.data-body {
  margin-top: 0.5rem;
}

.data-spell-classes {
  --spell-classes-start: var(--itdatd-spell-primary-section);
  --spell-classes-end: var(--itdatd-spell-primary-subsection);
  position: relative;
  display: grid;
  gap: 0.35rem;
  margin-top: 0.75rem;
  padding: 1.1rem 1.25rem 1rem;
  overflow: hidden;
  border-left: 5px solid var(--spell-classes-start);
  border-radius: 0 var(--itdatd-card-radius) var(--itdatd-card-radius) 0;
  background: linear-gradient(
    135deg,
    color-mix(in srgb, var(--spell-classes-start) 12%, var(--sl-color-bg)),
    color-mix(in srgb, var(--spell-classes-end) 8%, var(--sl-color-bg))
  );
}

.data-spell-classes--reversible {
  --spell-classes-end: var(--itdatd-spell-reverse-section);
}

.data-spell-classes::before {
  position: absolute;
  inset: 0 0 auto;
  height: 4px;
  background: linear-gradient(90deg, var(--spell-classes-start), var(--spell-classes-end));
  content: "";
}

.data-spell-classes__title {
  margin: 0;
  color: var(--sl-color-white);
  font-size: 1.35rem;
}

.data-spell-classes p {
  margin: 0;
  font-size: 1.05rem;
}

.data-spell-classes em {
  color: var(--sl-color-white);
  font-weight: 700;
}

.data-spell-classes ul {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
  gap: 0.35rem 1.5rem;
  margin: 0.2rem 0 0;
  padding-left: 1.25rem;
}

.data-spell-classes li::marker {
  color: var(--spell-classes-start);
}

/* Spell pages provide their own primary header, so remove Starlight's separate title panel. */
:global(body:has(.data-detail--spell) main > .content-panel:first-of-type) {
  display: none;
}

.weapon-rules-links {
  display: grid;
  gap: 1.25rem;
}

.weapon-rules-links h2 {
  margin-bottom: 0.5rem;
}

.weapon-rules-links p {
  margin: 0;
}

.proficiency-list {
  display: grid;
  gap: 0.35rem;
  margin: 0;
}

.proficiency-row {
  display: grid;
  grid-template-columns: minmax(7rem, 9rem) 1fr;
  gap: 1rem;
}

.proficiency-row dt {
  font-weight: 600;
}

.proficiency-row dd {
  margin: 0;
}

.warning {
  border: 1px solid var(--sl-color-red, #dc2626);
  border-radius: 0.5rem;
  padding: 1rem;
  background: color-mix(in srgb, var(--sl-color-red, #dc2626) 8%, transparent);
}

</style>
