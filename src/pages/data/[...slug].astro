---
import { getCollection, render } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

export async function getStaticPaths() {
  const entries = await getCollection("data");
  return entries.map((entry) => ({
    params: {
      slug: entry.id,
    },
    props: { id: entry.id },
  }));
}

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join("/") : slugParam;
const entries = await getCollection("data");
const entry = entries.find((item) => item.id === slug);

if (!entry) {
  throw new Error(`No data entry found for slug: ${slug}`);
}

const renderResult = await render(entry);
const { Content } = renderResult ?? {};

const detailFields = [
  {
    key: "level",
    label: "Spell Level",
    value: entry.data.level !== undefined ? `${entry.data.level}` : undefined,
  },
  {
    key: "actioncost",
    label: "Action Cost",
    value: entry.data.actioncost,
  },
  {
    key: "castspeed",
    label: "Cast Speed",
    value: entry.data.castspeed !== undefined ? `${entry.data.castspeed}` : undefined,
  },
  {
    key: "range",
    label: "Range",
    value: entry.data.range,
  },
  {
    key: "duration",
    label: "Duration",
    value: entry.data.duration,
  },
  {
    key: "classes",
    label: "Classes",
    value:
      Array.isArray(entry.data.classes) && entry.data.classes.length > 0
        ? [...entry.data.classes].sort((a, b) => a.localeCompare(b)).join(", ")
        : undefined,
  },
];

const description = entry.data.shortDescription ?? entry.data.excerpt ?? undefined;
---

<StarlightPage
  frontmatter={{
    title: entry.data.title,
    description,
  }}
>
  <article class="spell-detail">
    {description ? <p class="spell-lead"><em>{description}</em></p> : null}

    <div class="spell-metadata">
      {detailFields.map((field) =>
        field.value ? (
          <p class="spell-metadata-item">
            <strong class="spell-metadata-label">{field.label}:</strong>{" "}
            <em class="spell-metadata-value">{field.value}</em>
          </p>
        ) : null
      )}
    </div>

    {Content ? (
      <div class="spell-body">
        <Content />
      </div>
    ) : (
      <div class="warning">
        <p>Unable to render Content for entry <strong>{entry.id}</strong>.</p>
        <pre>{JSON.stringify({ id: entry.id, filePath: entry.filePath, data: entry.data }, null, 2)}</pre>
      </div>
    )}
  </article>
</StarlightPage>

<style>
.spell-detail {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.spell-lead {
  margin: 0;
  font-size: 1.05rem;
  color: var(--sl-color-text-accent, #374151);
}

.spell-metadata {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
  margin: 0;
}

.spell-metadata-item {
  line-height: 1.35;
  margin: 0;
}

.spell-metadata-label {
  font-weight: 600;
  color: var(--sl-color-text, #111827);
}

.spell-metadata-value {
  color: var(--sl-color-text, #111827);
}

.spell-body {
  margin-top: 0.5rem;
}

.warning {
  border: 1px solid var(--sl-color-red, #dc2626);
  border-radius: 0.5rem;
  padding: 1rem;
  background: color-mix(in srgb, var(--sl-color-red, #dc2626) 8%, transparent);
}
</style>
