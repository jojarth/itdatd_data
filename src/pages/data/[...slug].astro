---
import { getCollection, getEntry, render } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import WeaponLookup from "../../components/WeaponLookup.astro";

export async function getStaticPaths() {
  const [spells, weapons, weaponProperties, weaponFeatures] = await Promise.all([
    getCollection("data"),
    getCollection("weapons"),
    getCollection("weaponProperties"),
    getCollection("weaponFeatures"),
  ]);

  return [
    ...spells.map((entry) => ({
      params: { slug: entry.id },
      props: { collection: "data", id: entry.id },
    })),
    ...weapons.map((entry) => ({
      params: { slug: `weapons/${entry.id}` },
      props: { collection: "weapons", id: entry.id },
    })),
    ...weaponProperties.map((entry) => ({
      params: { slug: `weapon-properties/${entry.id}` },
      props: { collection: "weaponProperties", id: entry.id },
    })),
    ...weaponFeatures.map((entry) => ({
      params: { slug: `weapon-features/${entry.id}` },
      props: { collection: "weaponFeatures", id: entry.id },
    })),
  ];
}

type DetailCollection = "data" | "weapons" | "weaponProperties" | "weaponFeatures";

const { collection, id } = Astro.props as {
  collection: DetailCollection;
  id: string;
};
const entry = await getEntry(collection, id);

if (!entry) {
  throw new Error(`No ${collection} entry found for ID: ${id}`);
}

const renderResult = await render(entry);
const { Content } = renderResult ?? {};
const isSpell = collection === "data";
const isWeapon = collection === "weapons";

const detailFields = isSpell
  ? [
      {
        key: "level",
        label: "Spell Level",
        value: entry.data.level !== undefined ? `${entry.data.level}` : undefined,
      },
      {
        key: "casting",
        label: "Casting",
        value: entry.data.casting,
      },
      {
        key: "range",
        label: "Range",
        value: entry.data.range,
      },
      {
        key: "duration",
        label: "Duration",
        value: entry.data.duration,
      },
      {
        key: "classes",
        label: "Classes",
        value:
          Array.isArray(entry.data.classes) && entry.data.classes.length > 0
            ? [...entry.data.classes].sort((a, b) => a.localeCompare(b)).join(", ")
            : undefined,
      },
    ]
  : isWeapon
    ? [
        { key: "group", label: "Weapon Group", value: entry.data.group },
        { key: "cost", label: "Cost", value: entry.data.cost },
        { key: "ep", label: "EP", value: `${entry.data.ep}` },
        { key: "damage", label: "Damage", value: entry.data.damage },
        { key: "speed", label: "Speed", value: `${entry.data.speed}` },
        { key: "range", label: "Range", value: entry.data.range },
      ]
    : [];

const description = entry.data.shortDescription ?? entry.data.excerpt ?? undefined;
const weaponProperties = isWeapon ? entry.data.properties : [];
const proficiencyFeatures = isWeapon
  ? [
      { label: "Proficient", entries: entry.data.proficient },
      { label: "Skilled", entries: entry.data.skilled },
      { label: "Expert", entries: entry.data.expert },
      { label: "Master", entries: entry.data.master },
      { label: "Grand Master", entries: entry.data.grandmaster },
    ]
  : [];
---

<StarlightPage
  frontmatter={{
    title: entry.data.title,
    description,
  }}
>
  <article class="data-detail">
    {description ? <p class="data-lead"><em>{description}</em></p> : null}

    {detailFields.length > 0 ? (
      <div class="data-metadata">
        {detailFields.map((field) =>
          field.value !== undefined && field.value !== "" ? (
            <p class="data-metadata-item">
              <strong class="data-metadata-label">{field.label}:</strong>{" "}
              <em class="data-metadata-value">{field.value}</em>
            </p>
          ) : null
        )}
      </div>
    ) : null}

    {isWeapon ? (
      <div class="weapon-rules-links">
        <section>
          <h2>Weapon Properties</h2>
          {weaponProperties.length > 0 ? (
            <p>
              {weaponProperties.map((property, index) => (
                <>
                  {index > 0 ? ", " : null}
                  <WeaponLookup id={property.id} type="property" />
                </>
              ))}
            </p>
          ) : (
            <p>None.</p>
          )}
        </section>

        <section>
          <h2>Proficiency Features</h2>
          <dl class="proficiency-list">
            {proficiencyFeatures.map(({ label, entries }) => (
              <div class="proficiency-row">
                <dt>{label}</dt>
                <dd>
                  {entries.length > 0
                    ? entries.map((feature, index) => (
                        <>
                          {index > 0 ? ", " : null}
                          <WeaponLookup id={feature.id} type="feature" />
                        </>
                      ))
                    : "—"}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      </div>
    ) : null}

    {Content ? (
      <div class="data-body">
        <Content />
      </div>
    ) : (
      <div class="warning">
        <p>Unable to render Content for entry <strong>{entry.id}</strong>.</p>
        <pre>{JSON.stringify({ id: entry.id, filePath: entry.filePath, data: entry.data }, null, 2)}</pre>
      </div>
    )}
  </article>
</StarlightPage>

<style>
.data-detail {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.data-lead {
  margin: 0;
  font-size: 1.05rem;
  color: var(--sl-color-text-accent, #374151);
}

.data-metadata {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
  margin: 0;
}

.data-metadata-item {
  line-height: 1.35;
  margin: 0;
}

.data-metadata-label {
  font-weight: 600;
  color: var(--sl-color-text, #111827);
}

.data-metadata-value {
  color: var(--sl-color-text, #111827);
}

.data-body {
  margin-top: 0.5rem;
}

.weapon-rules-links {
  display: grid;
  gap: 1.25rem;
}

.weapon-rules-links h2 {
  margin-bottom: 0.5rem;
}

.weapon-rules-links p {
  margin: 0;
}

.proficiency-list {
  display: grid;
  gap: 0.35rem;
  margin: 0;
}

.proficiency-row {
  display: grid;
  grid-template-columns: minmax(7rem, 9rem) 1fr;
  gap: 1rem;
}

.proficiency-row dt {
  font-weight: 600;
}

.proficiency-row dd {
  margin: 0;
}

.warning {
  border: 1px solid var(--sl-color-red, #dc2626);
  border-radius: 0.5rem;
  padding: 1rem;
  background: color-mix(in srgb, var(--sl-color-red, #dc2626) 8%, transparent);
}
</style>
